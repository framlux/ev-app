		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@ev/core": "workspace:*",
		"@ev/db": "workspace:*",
		"@ev/tesla": "workspace:*",
		"@fontsource-variable/dm-sans": "^5.3.0",
		"jose": "^5.9.0",
